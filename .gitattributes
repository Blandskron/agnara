# Normalize to LF in the repository and in the working tree on every
# platform, so Windows, Linux and macOS CI lanes see identical bytes.
* text=auto eol=lf

# Lockfiles and binary assets
uv.lock text eol=lf
*.png binary
*.jpg binary
*.ico binary

# Vendored browser assets are checked against upstream byte hashes. Preserve
# upstream whitespace even when it would be rejected in authored source.
packages/agnara-http/src/agnara_http/_vendor/** -whitespace
