{
  "project": "Agnara",
  "tagline": "Capability-native Python for the agentic era.",
  "baseline": "Python >=3.14",
  "status": "architecture-first / pre-alpha",
  "architecture": {
    "core": "capability-first, transport-neutral",
    "application_model": "project -> bounded-context apps -> capabilities -> exposures",
    "default_app_scaffold": "modular-hexagonal"
  },
  "canonical_cli_examples": [
    "agnara project create commerce",
    "agnara app create payments --with http,mcp,tasks",
    "agnara capability create payments refund",
    "agnara inspect payments --json"
  ],
  "documents": [
